{
  "mcpServers": {
    "mcpjungle": {
      "serverUrl": "http://192.168.5.22:8080/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "deepseek": {
      "command": "python",
      "args": ["~/scripts/openrouter/deepseek_mcp.py"]
    },
    "rea": {
      "command": "ssh",
      "args": ["-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "daniel@192.168.3.45", "rea", "mcp"]
    },
    "claude-code-docs": {
      "serverUrl": "https://code.claude.com/docs/mcp"
    },
    "qdrant": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp-server-qdrant==0.8.1",
        "python",
        "-B",
        "F:/qdrant/agent_memory.py"
      ],
      "env": {
        "QDRANT_URL": "http://127.0.0.1:6333",
        "COLLECTION_NAME": "agent-memory",
        "FASTEMBED_CACHE_PATH": "F:/qdrant/fastembed_cache"
      }
    }
  }
}
