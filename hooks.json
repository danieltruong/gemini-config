{
  "reinforce": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./hooks/reinforce.py",
        "timeout": 5
      }
    ]
  },
  "deny-circuit-breaker": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/deny_circuit_breaker.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "commit-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/commit_gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "clock-wait-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/clock_wait_gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "no-ai-mentions": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|sed_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/no_ai_mentions.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "write-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|sed_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/write_gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "python ./hooks/stop_gate.py",
        "timeout": 900
      }
    ]
  }
}
